# ──────────────────────────────────────────────────────────────
# itto — environment config. Copy to .env and fill in.
# ──────────────────────────────────────────────────────────────

# ── Minecraft server the bot connects to ──
MC_SERVER_HOST=localhost
MC_SERVER_PORT=25565
MC_VERSION=1.20.6
# The username the bot logs in as.
MC_BOT_USERNAME=itto
# "offline" for cracked/LAN dev servers, "microsoft" for real accounts.
MC_AUTH=offline
# Only needed when MC_AUTH=microsoft (leave blank for offline mode).
MC_BOT_EMAIL=
# Username of the human the bot should follow + listen to.
MC_OWNER_USERNAME=

# ── MCP server (the control surface over the bot) ──
MCP_PORT=3001
# Loopback by default. These tools are FULL control of the bot: movement,
# mining, block placement, chat. Only widen this if you also set a token.
MCP_HOST=127.0.0.1
# Required in practice whenever MCP_HOST is not loopback. Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# ── Voice agent (apps/voice-agent) ──
# A SEPARATE Discord app/bot from jabby's. Joins a VC and runs a native
# speech-to-speech session whose function calls drive the bot over MCP.
AGARTHA_DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
# Gemini Live (speech-to-speech).
GEMINI_API_KEY=
# Where the voice agent reaches the Minecraft bot.
AGARTHA_MCP_URL=http://localhost:3001/mcp

# ── Shared memory (gbrain) ──
# The always-on gbrain HTTP server that owns the PGLite lock. Never point this
# at a second `gbrain serve` process; writes must go through one owner.
GBRAIN_MCP_URL=http://localhost:3131/mcp
# Create with: gbrain auth create agartha
GBRAIN_TOKEN=
# Where jabby lives, for building the shared persona from its prompt files.
JABBY_DIR=

# ── Brain: external agent ──
# When true, MC chat/events the bot deems worth reacting to are routed to an
# external agent that drives itto via the itto-mc MCP server (it replies by
# calling the `chat` tool). The agent is invoked as:  <BRAIN_CMD> "<prompt>"
# (prompt appended as the final arg), run in BRAIN_DIR. Any agent that takes a
# prompt as a trailing CLI arg and can reach itto-mc (:3001) works.
# Keep the actual command/path in your local .env (never commit it).
BRAIN_ENABLED=false
# e.g. jabby: `bun src/index.ts itto` runs a dedicated Minecraft brain session
BRAIN_CMD=
BRAIN_DIR=
# Min ms between agent spawns (each is a full model run).
BRAIN_COOLDOWN_MS=10000

# ── Reconnect (Minehut sleeps + kicks idle bots, so auto-rejoin) ──
RECONNECT_ENABLED=true
RECONNECT_DELAY_MS=5000
RECONNECT_MAX_DELAY_MS=60000

# ── Tuning ──
FAST_LOOP_HZ=15
SLOW_LOOP_INTERVAL_MS=4000
FOLLOW_TARGET_RANGE=3
TELEPORT_FALLBACK_DISTANCE=30
# How often (ms) to wake the brain to reassess even if nothing happened (0 = off).
# Keep modest — each beat is a brain turn. Event triggers fire regardless.
HEARTBEAT_MS=30000
LOG_LEVEL=info
